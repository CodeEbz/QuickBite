{
  "expo": {
    "name": "QuickBite",
    "slug": "quickbite",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.quickbite.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "icon": "./assets/icon.png"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "QuickBite needs gallery access so you can upload profile and food photos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "QuickBite needs camera access so you can snap food photos for similar meal search."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "QuickBite needs your location so customers can track active deliveries.",
          "locationWhenInUsePermission": "QuickBite needs your location so customers can track active deliveries."
        }
      ],
      "expo-secure-store"
    ],
    "scheme": "quickbite",
    "owner": "neeza",
    "extra": {
      "eas": {
        "projectId": "15517320-71cc-4ee6-9d27-e74dc1adfbea"
      }
    }
  }
}
